# ---- Server ----
PORT=8765
# Your first name, used by the advisors ("you" if blank)
SABHA_USER_NAME=

# ---- Qdrant ----
# Leave QDRANT_URL empty to use embedded local Qdrant (stored in data/qdrant_local).
# Docker:        QDRANT_URL=http://localhost:6333
# Qdrant Cloud:  QDRANT_URL=https://xxxx.cloud.qdrant.io  + QDRANT_API_KEY=...
QDRANT_URL=
QDRANT_API_KEY=
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Seed data/seed_memories.json automatically when the memory collection is empty
SEED_ON_START=true

# ---- Lyzr (https://studio.lyzr.ai -> Account -> API key) ----
# Without a key Sabha runs its advisors in "offline" mode (template reasoning over Qdrant memories).
LYZR_API_KEY=
LYZR_BASE_URL=https://agent-prod.studio.lyzr.ai
LYZR_PROVIDER=OpenAI
LYZR_MODEL=gpt-4o-mini
LYZR_CREDENTIAL_ID=lyzr_openai
LYZR_USER_ID=sabha-user
# Agents are auto-created on first start and their ids saved to data/lyzr_agents.json.
# To use agents you built in Lyzr Studio instead, set any of these:
# LYZR_AGENT_MODERATOR= / LYZR_AGENT_MENTOR= / LYZR_AGENT_SKEPTIC= / LYZR_AGENT_FUTURE_YOU=
# LYZR_AGENT_STRATEGIST= / LYZR_AGENT_GUARDIAN= / LYZR_AGENT_BIAS_RADAR= / LYZR_AGENT_SCRIBE=

# ---- Omi ----
# Developer API key (Omi app -> Settings -> Developer -> Create Key), starts with omi_dev_
OMI_API_KEY=
OMI_BASE_URL=https://api.omi.me
# Optional shared secret; when set, webhook URLs must include ?key=<value>
SABHA_WEBHOOK_KEY=

# ---- Tunnel ----
# cloudflared | ngrok | none.  PUBLIC_URL overrides auto-detection.
TUNNEL=cloudflared
PUBLIC_URL=

# ---- Debate pacing ----
# Seconds to wait after Round 1 for "Sabha, next round" / interjections before auto-continuing (0 = wait for command)
AUTO_ADVANCE_SECONDS=15
