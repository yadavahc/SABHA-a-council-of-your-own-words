# Only needed when the Python server isn't on the default port.
# Dev proxy target for REST calls (server-side, used by `next dev`)
SABHA_API=http://127.0.0.1:8765
# Dev WebSocket URL (browser). Leave unset to use ws://<host>:8765/ws in dev and same-origin in production.
# NEXT_PUBLIC_SABHA_WS=ws://127.0.0.1:8765/ws
